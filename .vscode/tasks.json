{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build: api",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/src/FiveTalents.Api/FiveTalents.Api.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile",
      "group": "build",
      "presentation": { "reveal": "silent" }
    },
    {
      "label": "watch: api",
      "command": "dotnet",
      "type": "process",
      "args": [
        "watch",
        "--project",
        "${workspaceFolder}/src/FiveTalents.Api/FiveTalents.Api.csproj"
      ],
      "problemMatcher": "$msCompile",
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "servers" }
    },
    {
      "label": "stop: angular",
      "type": "shell",
      "command": "fuser -k 4200/tcp 2>/dev/null || true",
      "presentation": { "reveal": "silent", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "stop: all",
      "dependsOn": ["stop: angular"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "pre-launch: full stack",
      "dependsOn": ["build: api"],
      "dependsOrder": "parallel",
      "group": "build"
    },
    {
      "label": "start: docker compose (lab)",
      "type": "shell",
      "command": "docker --context lab-docker compose -f docker-compose.yml -f docker-compose.lab.yml up --build",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "docker-compose-lab",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^(Building|Pulling|Starting|Creating|Recreating)",
          "endsPattern": "start worker processes"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "servers" }
    },
    {
      "label": "stop: docker compose (lab)",
      "type": "shell",
      "command": "docker --context lab-docker compose -f docker-compose.yml -f docker-compose.lab.yml down",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "silent", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "serve: angular",
      "type": "shell",
      "command": "npm run start",
      "options": {
        "cwd": "${workspaceFolder}/web/five-talents-web"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "angular",
        "pattern": { "regexp": "^(.*)$", "file": 1, "location": 2, "message": 3 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Building\\.\\.\\.",
          "endsPattern": "Local:.*http://localhost"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "servers" }
    }
  ]
}
