meta {
  name: Update Member - Not Found
  type: http
  seq: 12
}

put {
  url: {{baseUrl}}/api/members/999999
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "id": 999999,
    "firstName": "Ghost",
    "lastName": "Member",
    "status": "Active"
  }
}

tests {
  test("status 404", function() {
    expect(res.status).to.equal(404);
  });
}
