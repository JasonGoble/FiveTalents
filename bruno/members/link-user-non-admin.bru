meta {
  name: Link User - Non-Admin Forbidden
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/api/members/{{memberId}}/link-user
  body: json
  auth: bearer
}

auth:bearer {
  token: {{nonAdminToken}}
}

body:json {
  {
    "userId": "some-user-id"
  }
}

tests {
  test("status 401 or 403", function() {
    expect([401, 403]).to.include(res.status);
  });
}
