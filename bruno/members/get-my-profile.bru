meta {
  name: Get My Profile
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/members/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

tests {
  test("status 200 or 204", function() {
    expect([200, 204]).to.include(res.status);
  });

  test("has id and firstName when linked", function() {
    if (res.status === 200) {
      expect(res.body).to.have.property("id");
      expect(res.body).to.have.property("firstName");
    }
  });
}
