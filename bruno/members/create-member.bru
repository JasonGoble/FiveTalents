meta {
  name: Create Member
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/members
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "organizationId": {{organizationId}},
    "firstName": "Test",
    "lastName": "Member",
    "dateOfBirth": "1990-01-15T00:00:00Z",
    "gender": "Male",
    "maritalStatus": "Single",
    "joinDate": "2024-01-01T00:00:00Z",
    "addresses": [],
    "emails": [
      { "contactTypeId": 5, "email": "testmember+{{$timestamp}}@example.com", "isPrimary": true }
    ],
    "phones": []
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("memberId", String(res.body.id));
  }
}

tests {
  test("status 201", function() {
    expect(res.status).to.equal(201);
  });

  test("returns id", function() {
    expect(res.body).to.have.property("id");
  });
}
