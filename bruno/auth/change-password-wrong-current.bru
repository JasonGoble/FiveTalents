meta {
  name: Change Password - Wrong Current Password
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/auth/change-password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "currentPassword": "wrong-password-xyz",
    "newPassword": "NewPass1234!"
  }
}

tests {
  test("status 400 or 401", function() {
    expect([400, 401]).to.include(res.status);
  });
}
