meta {
  name: Login - Wrong Password
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "wrong-password-xyz"
  }
}

tests {
  test("status 401", function() {
    expect(res.status).to.equal(401);
  });
}
