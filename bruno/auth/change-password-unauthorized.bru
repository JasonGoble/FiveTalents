meta {
  name: Change Password - No Token
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/auth/change-password
  body: json
  auth: none
}

body:json {
  {
    "currentPassword": "anything",
    "newPassword": "NewPass1234!"
  }
}

tests {
  test("status 401", function() {
    expect(res.status).to.equal(401);
  });
}
