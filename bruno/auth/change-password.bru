meta {
  name: Change Password
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/auth/change-password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "currentPassword": "{{adminPassword}}",
    "newPassword": "{{adminPassword}}"
  }
}

tests {
  test("status 200 or 204", function() {
    expect([200, 204]).to.include(res.status);
  });
}
