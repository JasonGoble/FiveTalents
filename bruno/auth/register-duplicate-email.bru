meta {
  name: Register - Duplicate Email
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "firstName": "Test",
    "lastName": "User",
    "email": "{{adminEmail}}",
    "password": "Test1234!"
  }
}

tests {
  test("status 400 or 409", function() {
    expect([400, 409]).to.include(res.status);
  });
}
