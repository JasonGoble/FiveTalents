meta {
  name: Update Family - No Token
  type: http
  seq: 12
}

put {
  url: {{baseUrl}}/api/families/{{familyId}}
  body: json
  auth: none
}

body:json {
  {
    "id": 1,
    "name": "Should Not Update"
  }
}

tests {
  test("status 401", function() {
    expect(res.status).to.equal(401);
  });
}
